diff a/.gitignore b/.gitignore	(rejected hunks)
@@ -6,39 +6,8 @@ config.json
 # 共享便携 Python 运行时入库（全部内置技能与语音组件共用，全新克隆零装配即用）：
 # 放在 *.exe 规则之后放行运行时内全部文件（含 python.exe、Scripts\*.exe）
 !技能/_runtime/**
-# —— 按任务临时装配进共享运行时的重依赖（不入库；与下方/上方内置技能基线不重叠，
-#    全新克隆由对应技能按需重装）。以本机 site-packages 实际内容盘点为准 ——
-# GPU 加速大包（数 GB 级 CUDA 库，按机器有无显卡装配；含 torch/triton 等同类防未来形态）
-技能/_runtime/**/site-packages/nvidia/
-技能/_runtime/**/site-packages/nvidia_*/
-技能/_runtime/**/site-packages/torch*/
-技能/_runtime/**/site-packages/triton*/
-技能/_runtime/**/site-packages/*cudnn*/
-技能/_runtime/**/site-packages/*cublas*/
-# faster-whisper 语音转写链本体与专有依赖（AI 剪视频技能临时装配，非内置技能基线）
-技能/_runtime/**/site-packages/faster_whisper*/
-技能/_runtime/**/site-packages/ctranslate2*/
-技能/_runtime/**/site-packages/tokenizers*/
-技能/_runtime/**/site-packages/huggingface_hub*/
-技能/_runtime/**/site-packages/hf_xet*/
-技能/_runtime/**/site-packages/av/
-技能/_runtime/**/site-packages/av-*/
-技能/_runtime/**/site-packages/av.libs/
-# 上述链条带入的纯传递依赖（内置技能基线从未用到）
-技能/_runtime/**/site-packages/anyio*/
-技能/_runtime/**/site-packages/click*/
-技能/_runtime/**/site-packages/filelock*/
-技能/_runtime/**/site-packages/fsspec*/
-技能/_runtime/**/site-packages/h11*/
-技能/_runtime/**/site-packages/httpcore2*/
-技能/_runtime/**/site-packages/httpx2*/
-技能/_runtime/**/site-packages/truststore*/
-# 装配链带入的命令行入口（基线 Scripts 里的 pip/sherpa-onnx 等不受影响）
-技能/_runtime/python/Scripts/ct2-*.exe
-技能/_runtime/python/Scripts/hf.exe
-技能/_runtime/python/Scripts/httpx2.exe
-技能/_runtime/python/Scripts/pyav.exe
-技能/_runtime/python/Scripts/tiny-agents.exe
+# 共享运行时只放基线（内置技能/组件依赖），任务域依赖放各自工具目录——
+# 归属规范见 AGENT.md「运行时与依赖归属」。装错地方会直接出现在 git status，不做忽略遮丑。
 # bridge.go 运行期幂等维护的 run_python 工具桥（删了自动重建，属运行时状态非基线）
 技能/_runtime/**/site-packages/sitecustomize.py
 # 内置组件（Cua 驱动等外部二进制）：与运行时同口径入库——安装包必须离线自包含
